# Server settings only. Copy to ignored .env.hosted, never commit secrets.
APPLYWEAVE_MODE=hosted
APP_ORIGIN=https://your-project.vercel.app
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/auth/google/callback
OWNER_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SPREADSHEET_ID=
# Supabase transaction pooler URL, not the anonymous Data API URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=applyweave-resumes
# Generate 32 random bytes, encode as 64 hex characters. Preserve securely.
TOKEN_ENCRYPTION_KEY=
# Explicitly enable gemini or openai after reviewing data terms and budget.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=20
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096
