/** ApplyWeave tracker. Paste into a script bound to the target Google Sheet. */
const AW = {
  applications: 'Applications',
  today: 'Today',
  profile: 'Profile & Answers',
  dashboard: 'Dashboard',
  statuses: ['Saved', 'Preparing', 'Applied', 'Assessment', 'Interview', 'Offer', 'Rejected', 'Withdrawn'],
  roles: ['Software Development Engineer', 'Frontend Engineer', 'Backend Engineer', 'Full Stack Developer', 'AI Engineer', 'MERN Developer'],
  sources: ['LinkedIn', 'Wellfound', 'Company portal', 'Referral', 'Other'],
  modes: ['Remote', 'Hybrid', 'On-site', 'Unknown'],
  headers: [
    'Application ID', 'Company', 'Job Title', 'Role Family', 'Source', 'Job URL',
    'Location', 'Work Mode', 'Compensation (LPA)', 'Date Saved', 'Date Applied',
    'Status', 'Resume Version', 'Answer Pack ID', 'Next Action', 'Due Date',
    'Last Updated', 'Recruiter / Contact', 'Response Date', 'Interview Date',
    'Outcome / Reason', 'Notes', 'Duplicate Check'
  ]
};

function onOpen() {
  SpreadsheetApp.getUi().createMenu('ApplyWeave')
    .addItem('Set up tracker', 'setupApplyWeave')
    .addItem('Add or update application', 'showApplicationSidebar')
    .addItem('Export approved profile', 'showProfileExport')
    .addToUi();
}

function onEdit(event) {
  const range = event && event.range;
  if (!range || range.getSheet().getName() !== AW.profile) return;
  const first = range.getColumn(), last = first + range.getNumColumns() - 1;
  if (![1, 2, 3, 4, 7].some(column => column >= first && column <= last)) return;
  const sheet = range.getSheet();
  const start = Math.max(2, range.getRow());
  const count = range.getRow() + range.getNumRows() - start;
  if (count < 1) return;
  sheet.getRange(start, 5, count, 1).setValue(false);
  sheet.getRange(start, 6, count, 1).clearContent();
}

function setupApplyWeave() {
  const book = SpreadsheetApp.getActiveSpreadsheet();
  const apps = ensureApplications_(book);
  ensureView_(book, AW.today, ['Application ID', 'Company', 'Job Title', 'Status', 'Next Action', 'Due Date', 'Interview Date'],
    '=IFERROR(SORT(FILTER({Applications!A2:A,Applications!B2:B,Applications!C2:C,Applications!L2:L,Applications!O2:O,Applications!P2:P,Applications!T2:T},Applications!A2:A<>"",Applications!L2:L<>"Rejected",Applications!L2:L<>"Withdrawn",((Applications!P2:P<>"")*(Applications!P2:P<=TODAY()+7)+(Applications!T2:T<>"")*(Applications!T2:T>=TODAY())*(Applications!T2:T<=TODAY()+7)+(Applications!P2:P="")*((Applications!L2:L="Saved")+(Applications!L2:L="Preparing")))>0),6,TRUE),"No actions due in the next 7 days")');
  ensureProfile_(book);
  ensureDashboard_(book);
  book.setActiveSheet(apps);
  SpreadsheetApp.getUi().alert('ApplyWeave is ready. Add a role from the ApplyWeave menu.');
}

function ensureApplications_(book) {
  let sheet = book.getSheetByName(AW.applications);
  if (!sheet) {
    const initial = book.getSheetByName('Sheet1');
    if (initial && initial.getLastRow() === 0 && initial.getLastColumn() === 0) {
      initial.setName(AW.applications);
      sheet = initial;
    } else {
      sheet = book.insertSheet(AW.applications, 0);
    }
  }
  const current = sheet.getRange(1, 1, 1, AW.headers.length).getValues()[0];
  if (current.some(String) && current.join('|') !== AW.headers.join('|')) {
    throw new Error('Applications already has different headers. No existing data was changed.');
  }
  sheet.getRange(1, 1, 1, AW.headers.length).setValues([AW.headers]);
  styleHeader_(sheet, AW.headers.length);
  sheet.setFrozenRows(1);
  sheet.setFrozenColumns(3);
  sheet.getRange('J:K').setNumberFormat('dd mmm yyyy');
  sheet.getRange('P:Q').setNumberFormat('dd mmm yyyy');
  sheet.getRange('S:T').setNumberFormat('dd mmm yyyy');
  sheet.getRange('I:I').setNumberFormat('0.0');
  sheet.getRange('B:C').setColumnWidth(210);
  sheet.setColumnWidth(6, 300);
  sheet.setColumnWidth(15, 230);
  const rows = sheet.getMaxRows() - 1;
  setListRule_(sheet.getRange(2, 4, rows, 1), AW.roles);
  setListRule_(sheet.getRange(2, 5, rows, 1), AW.sources);
  setListRule_(sheet.getRange(2, 8, rows, 1), AW.modes);
  setListRule_(sheet.getRange(2, 12, rows, 1), AW.statuses);
  if (!sheet.getFilter()) sheet.getRange(1, 1, sheet.getMaxRows(), AW.headers.length).createFilter();
  sheet.getRange('W2').setFormula('=MAP(A2:A,B2:B,C2:C,F2:F,LAMBDA(id,company,title,url,IF(id="","",IF(AND(url<>"",COUNTIF(F2:F,url)>1),"CHECK URL",IF(COUNTIFS(B2:B,company,C2:C,title)>1,"CHECK ROLE","")))))');
  protectWarning_(sheet.getRange(2, 1, rows, 1), 'Application IDs are generated by ApplyWeave');
  protectWarning_(sheet.getRange(2, 23, rows, 1), 'Duplicate check is calculated');
  const due = sheet.getRange(2, 16, rows, 1);
  const interviews = sheet.getRange(2, 20, rows, 1);
  const rules = [
    SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=AND($A2<>"",$P2<TODAY(),$P2<>"",$L2<>"Rejected",$L2<>"Withdrawn",$L2<>"Offer")').setBackground('#fde8e8').setRanges([due]).build(),
    SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=AND($A2<>"",$P2>=TODAY(),$P2<=TODAY()+2,$L2<>"Rejected",$L2<>"Withdrawn",$L2<>"Offer")').setBackground('#fff1c2').setRanges([due]).build(),
    SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=AND($A2<>"",$T2>=TODAY(),$T2<=TODAY()+7,$L2<>"Rejected",$L2<>"Withdrawn")').setBackground('#dff2eb').setRanges([interviews]).build()
  ];
  sheet.setConditionalFormatRules(rules);
  return sheet;
}

function ensureView_(book, name, headers, formula) {
  let sheet = book.getSheetByName(name);
  if (!sheet) sheet = book.insertSheet(name, 0);
  if (sheet.getLastRow() > 0 && sheet.getRange('A1').getValue() !== headers[0]) {
    throw new Error(name + ' contains other data. No existing data was changed.');
  }
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  const formulaCell = sheet.getRange('A2');
  const currentFormula = formulaCell.getFormula();
  if (currentFormula && !currentFormula.startsWith('=IFERROR(SORT(FILTER({Applications!A2:A')) {
    throw new Error(name + ' has a custom A2 formula. Review it before replacing the ApplyWeave view.');
  }
  if (!currentFormula && formulaCell.getValue()) throw new Error(name + ' has data in A2. No existing data was changed.');
  formulaCell.setFormula(formula);
  styleHeader_(sheet, headers.length);
  sheet.setFrozenRows(1);
  sheet.setColumnWidths(1, headers.length, 170);
  sheet.setColumnWidth(5, 250);
  sheet.getRange('F:G').setNumberFormat('dd mmm yyyy');
}

function ensureProfile_(book) {
  let sheet = book.getSheetByName(AW.profile);
  if (!sheet) sheet = book.insertSheet(AW.profile);
  const headers = ['Type', 'Key / Fact ID', 'Value / Approved Wording', 'Source', 'Approved', 'Last Reviewed', 'Supporting Fact IDs'];
  const current = sheet.getRange(1, 1, 1, headers.length).getValues()[0];
  if (current.some(String) && current.join('|') !== headers.join('|')) {
    throw new Error('Profile & Answers has different headers. No existing data was changed.');
  }
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  styleHeader_(sheet, headers.length);
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(3, 420);
  sheet.setColumnWidth(4, 220);
  setListRule_(sheet.getRange(2, 1, sheet.getMaxRows() - 1, 1), ['Contact', 'Fact', 'Standard answer', 'Resume']);
  sheet.getRange(2, 5, sheet.getMaxRows() - 1, 1)
    .setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());
  sheet.getRange('F:F').setNumberFormat('dd mmm yyyy');
}

function ensureDashboard_(book) {
  let sheet = book.getSheetByName(AW.dashboard);
  if (!sheet) sheet = book.insertSheet(AW.dashboard, 0);
  if (sheet.getLastRow() > 0 && sheet.getRange('A1').getValue() !== 'ApplyWeave overview') {
    throw new Error('Dashboard contains other data. No existing data was changed.');
  }
  sheet.getRange('A1').setValue('ApplyWeave overview').setFontWeight('bold').setFontSize(16);
  sheet.getRange('A3:B3').setValues([['Stage', 'Applications']]);
  sheet.getRange(4, 1, AW.statuses.length, 1).setValues(AW.statuses.map(s => [s]));
  sheet.getRange(4, 2, AW.statuses.length, 1).setFormulas(AW.statuses.map((_, i) => ['=COUNTIF(Applications!L2:L,A' + (i + 4) + ')']));
  sheet.getRange('D3:E3').setValues([['Activity', 'Count']]);
  sheet.getRange('D4:D7').setValues([['Total roles'], ['Applied this week'], ['Interviews'], ['Overdue actions']]);
  sheet.getRange('E4').setFormula('=COUNTA(Applications!A2:A)');
  sheet.getRange('E5').setFormula('=COUNTIFS(Applications!K2:K,">="&TODAY()-WEEKDAY(TODAY(),2)+1,Applications!K2:K,"<="&TODAY())');
  sheet.getRange('E6').setFormula('=COUNTIF(Applications!L2:L,"Interview")');
  sheet.getRange('E7').setFormula('=COUNTIFS(Applications!P2:P,"<"&TODAY(),Applications!P2:P,"<>",Applications!L2:L,"<>Rejected",Applications!L2:L,"<>Withdrawn")');
  sheet.getRange('A3:B3').setBackground('#17324d').setFontColor('#ffffff').setFontWeight('bold');
  sheet.getRange('D3:E3').setBackground('#17324d').setFontColor('#ffffff').setFontWeight('bold');
  sheet.setColumnWidths(1, 5, 180);
}

function showApplicationSidebar() {
  SpreadsheetApp.getUi().showSidebar(HtmlService.createHtmlOutputFromFile('Sidebar').setTitle('ApplyWeave'));
}

function showProfileExport() {
  showApplicationSidebar();
}

function addApplication(input) {
  const company = clean_(input.company);
  const title = clean_(input.title);
  if (!company || !title) throw new Error('Company and job title are required.');
  if (input.roleFamily && AW.roles.indexOf(input.roleFamily) < 0) throw new Error('Unknown role family.');
  if (input.source && AW.sources.indexOf(input.source) < 0) throw new Error('Unknown source.');
  if (input.workMode && AW.modes.indexOf(input.workMode) < 0) throw new Error('Unknown work mode.');
  const url = clean_(input.jobUrl);
  if (url && !/^https?:\/\//i.test(url)) throw new Error('Job URL must begin with http:// or https://.');
  return withDocumentLock_(() => {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(AW.applications);
  if (!sheet) throw new Error('Run Set up tracker first.');
  const existing = sheet.getLastRow() > 1 ? sheet.getRange(2, 1, sheet.getLastRow() - 1, 6).getValues() : [];
  const duplicate = existing.find(r => (url && String(r[5]).trim() === url) || (unsafedSheetText_(r[1]).toLowerCase() === company.toLowerCase() && unsafedSheetText_(r[2]).toLowerCase() === title.toLowerCase()));
  if (duplicate && !input.allowDuplicate) throw new Error('Possible duplicate: ' + duplicate[0] + '. Check the existing row, or explicitly allow a second application.');
  const now = new Date();
  const prefix = 'AW-' + Utilities.formatDate(now, Session.getScriptTimeZone(), 'yyyyMMdd') + '-';
  const existingIds = new Set(existing.map(r => String(r[0])));
  let id = '';
  for (let attempt = 0; attempt < 5; attempt++) {
    id = prefix + Utilities.getUuid().slice(0, 8).toUpperCase();
    if (!existingIds.has(id)) break;
  }
  if (existingIds.has(id)) throw new Error('Could not create a unique Application ID. Try again.');
  const due = input.dueDate ? parseDate_(input.dueDate) : now;
  const row = [id, safeSheetText_(company), safeSheetText_(title), input.roleFamily || '', input.source || '', url,
    safeSheetText_(input.location), input.workMode || 'Unknown', numberOrBlank_(input.compensationLpa), now,
    '', 'Saved', safeSheetText_(input.resumeVersion), '', safeSheetText_(input.nextAction) || 'Review JD and prepare application', due,
    now, '', '', '', '', safeSheetText_(input.notes), ''];
  const targetRow = nextApplicationRow_(sheet);
  sheet.getRange(targetRow, 1, 1, 22).setValues([row.slice(0, 22)]);
  if (url) sheet.getRange(targetRow, 6).setRichTextValue(SpreadsheetApp.newRichTextValue().setText(url).setLinkUrl(url).build());
  return {applicationId: id, duplicateWarning: duplicate ? 'Second application for a matching role was recorded.' : ''};
  });
}

function listApplications() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(AW.applications);
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 12).getValues()
    .filter(r => r[0]).map(r => ({id: r[0], label: r[1] + ' — ' + r[2] + ' (' + r[11] + ')'})).reverse();
}

function updateApplication(input) {
  const id = clean_(input.applicationId);
  const status = clean_(input.status);
  if (!id) throw new Error('Choose an application.');
  if (AW.statuses.indexOf(status) < 0) throw new Error('Choose a valid status.');
  return withDocumentLock_(() => {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(AW.applications);
  const values = sheet.getRange(2, 1, Math.max(sheet.getLastRow() - 1, 1), AW.headers.length).getValues();
  const idx = values.findIndex(r => String(r[0]) === id);
  if (idx < 0) throw new Error('Application ID not found.');
  const row = values[idx];
  const now = new Date();
  const previousStatus = row[11];
  row[11] = status;
  row[16] = now;
  if (input.resumeVersion) row[12] = safeSheetText_(input.resumeVersion);
  if (input.answerPackId) row[13] = safeSheetText_(input.answerPackId);
  if (input.notes) row[21] = [row[21], safeSheetText_(input.notes)].filter(Boolean).join('\n');
  if (input.recruiterContact) row[17] = safeSheetText_(input.recruiterContact);
  if (input.responseDate) row[18] = parseDate_(input.responseDate);
  if (input.interviewDate) row[19] = parseDate_(input.interviewDate);
  if (input.outcome) row[20] = safeSheetText_(input.outcome);
  if (input.dateApplied) row[10] = parseDate_(input.dateApplied);
  else if (status === 'Applied' && !row[10]) row[10] = now;
  if (status === 'Rejected' || status === 'Withdrawn') {
    row[14] = '';
    row[15] = '';
  } else {
    const statusChanged = previousStatus !== status;
    const defaultAction = status === 'Applied' ? 'Follow up' : status === 'Assessment' ? 'Complete assessment' : status === 'Interview' ? 'Prepare for interview' : status === 'Offer' ? 'Review offer' : 'Review next step';
    row[14] = safeSheetText_(input.nextAction) || (statusChanged ? defaultAction : row[14]) || defaultAction;
    if (input.dueDate) row[15] = parseDate_(input.dueDate);
    else if (statusChanged || !row[15]) row[15] = new Date(now.getTime() + (status === 'Applied' ? 7 : 1) * 86400000);
  }
  sheet.getRange(idx + 2, 1, 1, 22).setValues([row.slice(0, 22)]);
  return {applicationId: id, status: status};
  });
}

function getDueActions() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(AW.applications);
  if (!sheet || sheet.getLastRow() < 2) return [];
  const cutoff = Date.now() + 7 * 86400000;
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 20).getValues().filter(r => {
    if (!r[0] || ['Rejected', 'Withdrawn'].indexOf(r[11]) >= 0) return false;
    const due = r[15] instanceof Date ? r[15].getTime() : Infinity;
    const interview = r[19] instanceof Date ? r[19].getTime() : Infinity;
    return due <= cutoff || (interview >= Date.now() - 86400000 && interview <= cutoff) ||
      (!Number.isFinite(due) && ['Saved', 'Preparing'].indexOf(r[11]) >= 0);
  }).map(r => ({applicationId:r[0], company:r[1], title:r[2], status:r[11], nextAction:r[14], dueDate:r[15], interviewDate:r[19]}));
}

function exportApprovedProfile() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(AW.profile);
  if (!sheet) throw new Error('Run Set up tracker first.');
  const rows = sheet.getLastRow() > 1 ? sheet.getRange(2, 1, sheet.getLastRow() - 1, 7).getValues() : [];
  const profile = {schemaVersion: 1, profileVersion: '', personal: {}, facts: [], standardAnswers: [], resumeVersions: []};
  rows.forEach(r => {
    if (r[4] !== true || !r[1] || !r[2]) return;
    const [type, key, value, source, , , factIds] = r;
    if (type === 'Contact') profile.personal[unsafedSheetText_(key)] = unsafedSheetText_(value);
    if (type === 'Fact') profile.facts.push({id:unsafedSheetText_(key), claim:unsafedSheetText_(value), source:unsafedSheetText_(source)});
    if (type === 'Standard answer') {
      const ids = String(factIds || '').split(',').map(s => s.trim()).filter(Boolean);
      if (!ids.length) throw new Error('Approved answer ' + key + ' needs supporting Fact IDs.');
      profile.standardAnswers.push({key:unsafedSheetText_(key), text:unsafedSheetText_(value), factIds:ids});
    }
    if (type === 'Resume') profile.resumeVersions.push({id:unsafedSheetText_(key), filename:unsafedSheetText_(value)});
  });
  const ids = new Set(profile.facts.map(f => f.id));
  profile.standardAnswers.forEach(a => a.factIds.forEach(id => { if (!ids.has(id)) throw new Error('Approved answer ' + a.key + ' references missing approved fact ' + id); }));
  const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, JSON.stringify(profile));
  profile.profileVersion = 'AW-' + Utilities.base64EncodeWebSafe(digest).slice(0, 12);
  return profile;
}

function importApprovedProfile(profile) {
  if (!profile || profile.schemaVersion !== 1 || !profile.personal || !Array.isArray(profile.facts) || !Array.isArray(profile.resumeVersions) || !Array.isArray(profile.standardAnswers)) {
    throw new Error('Import an ApplyWeave approved profile JSON file.');
  }
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(AW.profile);
  if (!sheet) throw new Error('Run Set up tracker first.');
  if (sheet.getLastRow() > 1) {
    const existing = sheet.getRange(2, 1, sheet.getLastRow() - 1, 7).getValues();
    if (existing.some(row => row.some((value, index) => index !== 4 && value !== '' && value != null))) {
      throw new Error('Profile & Answers already has rows. Review them before importing another file; no data was changed.');
    }
  }
  const now = new Date();
  const rows = [];
  Object.entries(profile.personal).forEach(([key, value]) => {
    if (typeof value !== 'string' || !value.trim()) return;
    if (/password|cookie|token|government/i.test(key)) throw new Error('Unsupported contact field: ' + key);
    rows.push(['Contact', safeSheetText_(key), safeSheetText_(value), 'Candidate confirmation', true, now, '']);
  });
  const ids = new Set();
  profile.facts.forEach(fact => {
    if (!fact.id || !fact.claim || ids.has(fact.id)) throw new Error('Facts need unique IDs and non-empty claims.');
    ids.add(fact.id);
    rows.push(['Fact', safeSheetText_(fact.id), safeSheetText_(fact.claim), safeSheetText_(fact.source || ''), true, now, '']);
  });
  profile.standardAnswers.forEach(answer => {
    if (!answer.key || !answer.text || !Array.isArray(answer.factIds) || !answer.factIds.length || answer.factIds.some(id => !ids.has(id))) throw new Error('Standard answers need approved supporting Fact IDs.');
    rows.push(['Standard answer', safeSheetText_(answer.key), safeSheetText_(answer.text), 'Candidate approved', true, now, safeSheetText_(answer.factIds.join(', '))]);
  });
  profile.resumeVersions.forEach(resume => {
    if (!resume.id || !resume.filename) throw new Error('Resume entries need an ID and filename.');
    rows.push(['Resume', safeSheetText_(resume.id), safeSheetText_(resume.filename), 'Candidate provided PDF', true, now, '']);
  });
  if (!rows.length) throw new Error('The profile has no approved content.');
  sheet.getRange(2, 1, rows.length, 7).setValues(rows);
  return {importedRows: rows.length};
}

function setListRule_(range, items) {
  range.setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(items, true).setAllowInvalid(false).build());
}
function styleHeader_(sheet, width) {
  sheet.getRange(1, 1, 1, width).setBackground('#17324d').setFontColor('#ffffff').setFontWeight('bold').setWrap(true);
  sheet.setRowHeight(1, 42);
}
function protectWarning_(range, message) {
  const existing = range.getSheet().getProtections(SpreadsheetApp.ProtectionType.RANGE).some(p => p.getDescription() === message);
  if (!existing) range.protect().setDescription(message).setWarningOnly(true);
}
function clean_(value) { return String(value == null ? '' : value).trim(); }
function safeSheetText_(value) {
  const text = clean_(value);
  return /^[=+\-@]/.test(text) ? "'" + text : text;
}
function unsafedSheetText_(value) { return String(value == null ? '' : value).trim().replace(/^'(?=[=+\-@])/, ''); }
function withDocumentLock_(action) {
  const lock = LockService.getDocumentLock() || LockService.getScriptLock();
  lock.waitLock(30000);
  try { return action(); }
  finally { lock.releaseLock(); }
}
function numberOrBlank_(value) {
  if (value === '' || value == null) return '';
  const number = Number(value);
  if (!Number.isFinite(number) || number < 0) throw new Error('Compensation must be a non-negative LPA number.');
  return number;
}
function parseDate_(value) {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) throw new Error('Invalid date: ' + value);
  return date;
}
function nextApplicationRow_(sheet) {
  const ids = sheet.getRange(2, 1, sheet.getMaxRows() - 1, 1).getValues();
  const blank = ids.findIndex(row => !row[0]);
  if (blank >= 0) return blank + 2;
  const last = sheet.getMaxRows();
  sheet.insertRowsAfter(last, 1);
  return last + 1;
}
